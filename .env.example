# Hindsight Configuration
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK_ID=prism-demo-team
HINDSIGHT_RETAIN_EXTRACTION_MODE=chunks

# Groq LLM Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Review limits
REVIEW_MAX_FILES=40
REVIEW_MAX_FILE_BYTES=200000
REVIEW_MAX_TOTAL_BYTES=2000000
REVIEW_CONCURRENCY=3
REVIEW_MAX_MEMORIES=5

# Git branch ingestion
GIT_CLONE_TIMEOUT=90

# Review job retention (seconds)
JOB_TTL_SECONDS=3600